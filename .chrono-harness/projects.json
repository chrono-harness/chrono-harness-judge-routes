            "crates/judge-routes-tests/tests/verified_admission.rs",
            "-o",
            ".chrono-harness/state/verify.route-admission-tests.rlib",
            "-Zchecksum-hash-algorithm=sha256"
          ],
          "output_contract": {
            "version": "0.2026.04.24.f8e1704",
            "commit": "f8e17045c4ac17a02e566b8997070f2eecc255be"
          }
        },
        "verify_bounds": {
          "operation": "verify.route-bounds-tests",
          "tool": "verus",
          "argv": [
            "--crate-type=lib",
            "--no-cheating",
            "--no-external-by-default",
            "--num-threads",
            "2",
            "--output-json",
            "--compile",
            "--emit=link=.chrono-harness/state/verify.route-bounds-tests.rlib,dep-info=.chrono-harness/state/verify.route-bounds-tests.rlib.d",
            "crates/judge-routes-tests/tests/verified_bounds.rs",
