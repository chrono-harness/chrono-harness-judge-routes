      "tool": "cargo",
      "argv": [
        "test",
        "--locked",
        "--manifest-path",
        "crates/host-bootstrap-tests/Cargo.toml",
        "--target-dir",
        ".chrono-harness/cache/host-bootstrap-native-tests/target"
      ]
    }
  ],
  "test.host-release-native-tests": [
    {
      "owner": "project:host-release-native-tests",
      "operation": "test.host-release-native-tests",
      "tool": "cargo",
      "argv": [
        "test",
        "--locked",
        "--manifest-path",
